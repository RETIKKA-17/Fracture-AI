# ==============================================================================
# FractureLens AI (WristAI) — Environment Configuration Template
# Copy this file to '.env' for local development overrides.
# ==============================================================================

# Application Meta
VITE_APP_TITLE=FractureLens AI
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Model Inference Configuration
# Path to the exported ResNet-18 ONNX model in public directory
VITE_MODEL_PATH=/models/wrist_model.onnx
VITE_INFERENCE_EXECUTION_PROVIDER=wasm

# Clinical Safety Thresholds
# Standard sigmoid classification threshold (tau = 0.50 by default, 0.65 for high-specificity mode)
VITE_DEFAULT_CLASSIFICATION_THRESHOLD=0.50
VITE_HIGH_SPECIFICITY_THRESHOLD=0.65

# Security & Session Settings
VITE_SESSION_TIMEOUT_MINUTES=60
VITE_ENABLE_AUDIT_LOGGING=true

# Demo Credentials for Prototype Testing
# DOCTOR: doctor.vance@wristai.org / DemoDoctor123!
# ADMIN:  admin@wristai.org / DemoAdmin123!
